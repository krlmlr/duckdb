# name: test/sql/types/geo/geometry_parquet_pushdown.test
# group: [geo]

require parquet

require json

statement ok
COPY (
	select
		(x + y) as id,
		printf('POINT(%d %d)', x, y)::GEOMETRY('OGC:CRS84') as g
	from range(100) xx(x), range(100) yy(y)
) TO '__TEST_DIR__/points.parquet' (FORMAT 'parquet', GEOPARQUET_VERSION 'V2', ROW_GROUP_SIZE 1000);

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '__TEST_DIR__/output.json';

statement ok
SET tracked_metrics = ['operator.type', 'operator.extra_info', 'operator.row_groups_scanned'];

statement ok
select * from '__TEST_DIR__/points.parquet' where g && 'POLYGON((10 10, 20 10, 20 20, 10 20, 10 10))'::GEOMETRY;

statement ok
RESET enable_profiling;

statement ok
CREATE VIEW operator_metrics AS WITH RECURSIVE ops(op) AS (
    SELECT unnest(CAST(j -> '$.operator' AS JSON[])) FROM (SELECT content::JSON AS j FROM read_text('__TEST_DIR__/output.json'))
    UNION ALL
    SELECT unnest(CAST(op -> '$.children' AS JSON[])) FROM ops WHERE json_array_length(op -> '$.children') > 0
)
SELECT
	op ->> '$.extra_info.Function' AS name,
	(op ->> '$.row_groups_scanned')::BIGINT AS scanned
FROM ops;

# Only 2 of the 10 row groups overlap the query polygon's bounding box, so the
# geometry zonemap pushdown prunes the other 8. (total_row_groups_to_scan is a
# per-thread running count and is not asserted here as it is non-deterministic.)
query II
SELECT * FROM operator_metrics WHERE name = 'PARQUET_SCAN';
----
PARQUET_SCAN	2
